  "strings" : {
    "" : {

    },
    "%@ caught your copy!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a attrapé votre copie !"
          }
        }
      }
    },
    "%@ dozed off while you were away." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est assoupi pendant votre absence."
          }
        }
      }
    },
    "%@ is dancing to “%@”." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ danse sur « %@ »."
          }
        }
      }
    },
    "%@ is dancing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ danse."
          }
        }
      }
    },
    "%@ is focusing with you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se concentre avec vous."
          }
        }
      }
    },
    "%@ is keeping an eye on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ veille sur votre Mac."
          }
        }
      }
    },
    "%@ is overheating: CPU at %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ surchauffe : processeur à %@."
          }
        }
      }
    },
    "%@ is overheating: the Mac is running hot." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ surchauffe : le Mac chauffe."
          }
        }
      }
    },
    "%@ is proud of you!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est fier de vous !"
          }
        }
      }
    },
    "%@ is ready when you are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est prêt quand vous l’êtes."
          }
        }
      }
    },
    "%@ is taking a break too." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait une pause, lui aussi."
          }
        }
      }
    },
    "%@ is waiting for you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vous attend."
          }
        }
      }
    },
    "%@ left" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore %@"
          }
        }
      }
    },
    "%@ likes this song." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aime ce morceau."
          }
        }
      }
    },
    "%@ loves that." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adore ça."
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sur %@"
          }
        }
      }
    },
    "%@ reacts to what you do everywhere: it dances to your music, catches your copies and tells you when Claude Code is done or needs you. On its page, start a focus session with it. Click it to pet it; its looks are behind the paintbrush." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ réagit à ce que vous faites, partout : il danse sur votre musique, attrape vos copies et vous prévient quand Claude Code a terminé ou a besoin de vous. Sur sa page, lancez une session de concentration avec lui. Cliquez dessus pour le caresser ; son apparence se règle derrière le pinceau."
          }
        }
      }
    },
    "%@ says Claude Code is done." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
