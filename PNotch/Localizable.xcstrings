    "~/.claude/settings.json isn't valid JSON. Fix it, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json n’est pas un JSON valide. Corrigez-le, puis réessayez."
          }
        }
      }
    }
