    },
    "While you're away from the session's terminal or editor, Claude Code waits for your answer in the notch: allow, always allow or deny. Back in the terminal, or with PNotch closed, it asks there as usual." : {
      "comment" : "A description of the settings related to Claude Code.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous n’êtes pas dans le terminal ou l’éditeur de la session, Claude Code attend votre réponse dans l’encoche : autoriser, toujours autoriser ou refuser. De retour dans le terminal, ou PNotch fermé, il demande là-bas comme d’habitude."
          }
        }
      }
    },
    "Works with any app that reports to Now Playing: Music, Spotify, podcasts, video in a browser…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec toute app qui alimente « À l’écoute » : Musique, Spotify, podcasts, vidéo dans un navigateur…"
          }
        }
      }
    },
    "Writing %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
